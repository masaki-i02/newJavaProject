flowchart TB
    S["対象社員と対象月"]
    B["① 基準日を決める<br/>対象月の初日<br/>（月中に所属開始があればその日）"]
    D["② 基準日時点の所属部署を得る"]
    L{"③ その部署に<br/>基準日時点の長がいるか"}
    C1{"④ 長は本人か"}
    C2{"④ 長は承認時点で<br/>退職していないか"}
    C3{"④ 部署は廃止されていないか"}
    OK["承認者に決定"]
    UP["親部署へ遡る"]
    ROOT{"根まで遡ったか"}
    HR["⑤ 人事担当が承認する<br/>HR_FALLBACK"]

    S --> B --> D --> C3
    C3 -- "廃止済み" --> UP
    C3 -- "現存" --> L
    L -- "いない" --> UP
    L -- "いる" --> C1
    C1 -- "本人（自己承認の禁止）" --> UP
    C1 -- "本人でない" --> C2
    C2 -- "退職済み" --> UP
    C2 -- "在籍中" --> OK
    UP --> ROOT
    ROOT -- "まだ親がある" --> C3
    ROOT -- "根に到達" --> HR
