classDiagram
    direction TB

    class EmployeeId {
        <<value>>
        UUID value
    }
    class Employee {
        <<record>>
        EmployeeId id
        EmployeeNumber number
        String name
        Email email
        EmploymentType employmentType
        LocalDate hiredOn
        LocalDate retiredOn
        isActiveOn(LocalDate) boolean
    }
    class EmploymentType {
        <<enum>>
        FULL_TIME
        PART_TIME
        CONTRACT
    }
    class Role {
        <<enum>>
        EMPLOYEE
        APPROVER
        HR
        ADMIN
    }
    class DepartmentId {
        <<value>>
        UUID value
    }
    class Department {
        <<record>>
        DepartmentId id
        DepartmentCode code
        String name
        DepartmentId parentId
        isRoot() boolean
    }
    class Assignment {
        <<record>>
        EmployeeId employeeId
        DepartmentId departmentId
        DateRange period
    }
    class Managership {
        <<record>>
        DepartmentId departmentId
        EmployeeId employeeId
        DateRange period
    }
    class DateRange {
        <<value>>
        LocalDate from
        LocalDate toExclusive
        contains(LocalDate) boolean
        overlaps(DateRange) boolean
    }
    class OrganizationChart {
        <<domain service>>
        departmentOf(EmployeeId, LocalDate) Optional~Department~
        managerOf(EmployeeId, LocalDate) Optional~EmployeeId~
        ancestorsOf(DepartmentId) List~Department~
    }

    Employee --> EmployeeId
    Employee --> EmploymentType
    Employee "1" --> "*" Role
    Department --> DepartmentId
    Department --> "0..1" DepartmentId : parentId
    Assignment --> EmployeeId
    Assignment --> DepartmentId
    Assignment --> DateRange
    Managership --> DepartmentId
    Managership --> EmployeeId
    Managership --> DateRange
    OrganizationChart ..> Assignment
    OrganizationChart ..> Managership
    OrganizationChart ..> Department
