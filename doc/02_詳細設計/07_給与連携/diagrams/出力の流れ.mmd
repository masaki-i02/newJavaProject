flowchart TB
    start(["人事が対象月を指定<br/>POST /api/payroll/exports"]) --> finished{"対象月は<br/>終わっているか"}
    finished -- いいえ --> err["422 month-not-finished<br/>依頼そのものの不備"]
    finished -- はい --> calendar{"年度のカレンダーは<br/>登録されているか"}
    calendar -- いいえ --> err2["422 calendar-not-registered<br/>365 日で計算した分母を残さない"]
    calendar -- はい --> roster["対象月に在籍していた社員を数え上げる<br/>（月中入社・月中退職を含む）"]
    roster --> loop{"社員ごと"}
    loop --> closed{"その月は<br/>締め済みか"}
    closed -- いいえ --> reason["除外する<br/>NOT_SUBMITTED / NOT_APPROVED / NOT_CLOSED<br/>/ NOT_SUBMITTABLE / NO_ATTENDANCE_RECORD<br/>/ DUPLICATE_EMPLOYEE_NUMBER"]
    closed -- はい --> read["保存済みの月次清算を読む<br/>（計算し直さない）"]
    read --> row["PayrollRow を組み立てる<br/>所定内 + 所定超 = 実労働 を検査"]
    reason --> record
    row --> record["payroll_exports に記録<br/>（誰が・いつ・何月・月平均）<br/>payroll_export_targets に対象社員"]
    record --> resp["201 + 除外した社員の一覧"]
    resp --> csv(["GET /api/payroll/exports/{id}<br/>text/csv"])

    classDef err fill:#fdecec,stroke:#c0392b
    class err,err2 err
