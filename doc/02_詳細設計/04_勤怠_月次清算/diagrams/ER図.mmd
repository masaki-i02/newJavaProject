erDiagram
    employees ||--o{ monthly_settlements : ""
    work_rules ||--o{ monthly_settlements : "計算に使った規則"
    monthly_settlements ||--o{ weekly_overtimes : "週40時間超の内訳"

    monthly_settlements {
        uuid id PK
        uuid employee_id FK
        date target_month "月初日。employee_id との組で一意"
        uuid work_rule_id FK
        varchar working_time_system "FIXED / FLEX"
        int working_minutes "実労働の合計"
        int legal_holiday_minutes "法定休日労働"
        int target_working_minutes "対象労働時間 = 実労働 − 法定休日"
        int scheduled_total_minutes "所定総労働時間"
        int statutory_total_limit_minutes "法定労働時間の総枠"
        int daily_overtime_minutes "日次で確定した法定外残業"
        int weekly_overtime_minutes "週40時間超"
        int overtime_minutes "時間外労働の合計"
        int shortage_minutes "不足時間"
        int night_minutes "深夜"
        int core_time_absence_minutes "コアタイム不在"
        boolean exceeds_monthly_agreement_limit "月45時間超"
        timestamptz calculated_at
        bigint version
    }
    weekly_overtimes {
        uuid id PK
        uuid monthly_settlement_id FK
        date week_start "週の起算日（日曜）"
        date week_end "週の末日"
        int statutory_inside_minutes "週の法定内労働時間"
        int overtime_minutes "40時間を超えた分"
    }
