erDiagram
    employees ||--o{ monthly_attendances : ""
    monthly_attendances ||--o{ approval_events : "状態遷移の証跡"
    employees ||--o{ time_clock_correction_requests : "申請する"
    time_clock_correction_requests ||--|{ time_clock_correction_items : "訂正内容"

    monthly_attendances {
        uuid id PK
        uuid employee_id FK
        date target_month "月初日。employee_id との組で一意"
        varchar status "DRAFT / SUBMITTED / APPROVED / CLOSED"
        timestamptz submitted_at "提出日時"
        uuid approved_by FK "承認者"
        timestamptz approved_at "承認日時"
        uuid closed_by FK "締めた人事"
        timestamptz closed_at "締め日時"
        bigint version "楽観ロック"
    }
    approval_events {
        uuid id PK
        uuid monthly_attendance_id FK
        varchar from_status "遷移元"
        varchar to_status "遷移先"
        uuid actor_id FK "実行者"
        varchar comment "差戻し理由など"
        timestamptz occurred_at "永続保持する監査証跡"
    }
    time_clock_correction_requests {
        uuid id PK
        uuid employee_id FK
        date work_date "訂正対象の勤務日"
        varchar status "SUBMITTED / APPROVED / REJECTED"
        varchar reason "申請理由。必須"
        timestamptz requested_at
        uuid decided_by FK "承認・却下した人"
        timestamptz decided_at
        varchar decision_comment
        bigint version
    }
    time_clock_correction_items {
        uuid id PK
        uuid request_id FK
        int sequence_no "適用順"
        varchar action "REVOKE / ADD"
        uuid target_event_id "REVOKE のとき対象打刻"
        varchar event_type "ADD のとき打刻種別"
        timestamptz occurred_at "ADD のとき打刻時刻"
    }
