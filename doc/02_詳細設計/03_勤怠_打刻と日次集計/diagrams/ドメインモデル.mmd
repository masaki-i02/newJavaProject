classDiagram
    direction TB

    class TimeClockEvent {
        <<sealed interface>>
        LocalDateTime occurredAt
        type() TimeClockEventType
    }
    class ClockIn { <<record>> }
    class ClockOut { <<record>> }
    class BreakStart { <<record>> }
    class BreakEnd { <<record>> }

    class TimeClockSequence {
        1 日分の打刻列
        validateTransitions() void
        isClosed() boolean
        toWorkedRanges() List~TimeRange~
        attendanceSpan() Optional~TimeRange~
    }
    class TimeRange {
        <<record>>
        LocalDateTime start
        LocalDateTime end
        duration() Duration
        intersect(TimeRange) Optional~TimeRange~
        splitAt(LocalDateTime) List~TimeRange~
    }
    class WorkSlice {
        <<record>>
        TimeRange range
        Set~PremiumType~ premiums
        with(PremiumType) WorkSlice
        splitAt(LocalDateTime) List~WorkSlice~
    }
    class PremiumType {
        <<enum · shared>>
        OVERTIME_WITHIN_STATUTORY
        OVERTIME_BEYOND_STATUTORY
        NIGHT
        LEGAL_HOLIDAY
        partitionsWorkingTime() boolean
    }
    class AttendanceRule {
        <<sealed interface>>
        apply(List~WorkSlice~) List~WorkSlice~
    }
    class CalendarDayBoundaryRule { <<record>> }
    class NightWorkRule { <<record>> }
    class LegalHolidayWorkRule { <<record>> }
    class DailyOvertimeRule { <<record>> }
    class DailyAttendance {
        <<record>>
        LocalDate workDate
        DayType dayType
        List~WorkSlice~ slices
        Duration workingTime
        Duration breakTime
        WorkingTimeSystemType workingTimeSystem
        Duration baseTime
        Duration overtimeWithinStatutoryTime
        Duration overtimeBeyondStatutoryTime
        Duration nightTime
        Duration legalHolidayTime
    }
    class DailyAttendanceCalculator {
        <<domain service>>
        calculate(LocalDate, TimeClockSequence, WorkRule, CompanyCalendar) DailyAttendance
    }
    class WorkRule {
        <<record · workrule>>
        WorkingTimeSystem workingTimeSystem
        NightWindow nightWindow
        Duration statutoryDailyWorkingTime
    }
    class CompanyCalendar {
        <<domain service · workrule>>
        dayTypeOf(LocalDate) DayType
    }

    TimeClockEvent <|.. ClockIn
    TimeClockEvent <|.. ClockOut
    TimeClockEvent <|.. BreakStart
    TimeClockEvent <|.. BreakEnd
    TimeClockSequence --> TimeClockEvent
    TimeClockSequence --> TimeRange
    WorkSlice --> TimeRange
    WorkSlice --> PremiumType
    AttendanceRule <|.. CalendarDayBoundaryRule
    AttendanceRule <|.. NightWorkRule
    AttendanceRule <|.. LegalHolidayWorkRule
    AttendanceRule <|.. DailyOvertimeRule
    LegalHolidayWorkRule ..> CompanyCalendar
    AttendanceRule ..> WorkSlice
    DailyAttendance --> WorkSlice
    DailyAttendanceCalculator ..> AttendanceRule
    DailyAttendanceCalculator ..> DailyAttendance
    DailyAttendanceCalculator ..> WorkRule
