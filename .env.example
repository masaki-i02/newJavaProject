# docker-compose.prod.yml が読む値。
#
#   cp .env.example .env
#   chmod 600 .env
#
# ★ .env はコミットしない（.gitignore に入っている）。
#   この .env.example は「何を渡す必要があるか」を残すためのものなので、
#   実在しない値だけを書く。

KINTAI_DB_NAME=kintai
KINTAI_DB_USER=kintai

# ★ 必ず変える。ここに書いてある値のまま本番へ出さない
KINTAI_DB_PASSWORD=change-me-before-deploying

# ホスト側で待ち受けるポート。リバースプロキシの後ろに置く
KINTAI_APP_PORT=8080
