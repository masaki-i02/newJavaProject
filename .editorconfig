# エディタ間でインデントや改行コードを揃えるための設定
# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java は 4 スペース（Google Java Style / Spring の慣習に合わせる）
[*.java]
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 4

# Markdown は行末の空白 2 つが改行の意味を持つため、削除しない
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
